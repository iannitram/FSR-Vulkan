@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@USCALE_WITH_VULKAN@)
    find_dependency(Vulkan)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/uscaleTargets.cmake")

if(TARGET uscale::uscale_vulkan AND NOT TARGET uscale::uscale)
    add_library(uscale::uscale ALIAS uscale::uscale_vulkan)
elseif(TARGET uscale::uscale_core AND NOT TARGET uscale::uscale)
    add_library(uscale::uscale ALIAS uscale::uscale_core)
endif()

if(TARGET uscale::uscale_core AND NOT TARGET uscale::core)
    add_library(uscale::core ALIAS uscale::uscale_core)
endif()

check_required_components(uscale)
